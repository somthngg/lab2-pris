<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_assessment" targetNamespace="https://example.org/consultation-concept">
  <bpmn:process id="Process_assessment" name="TO-BE: приём и ручная отметка результата" isExecutable="false">
    <bpmn:laneSet id="LaneSet_assessment">
      <bpmn:lane id="Lane_assessment_student" name="Студент">
        <bpmn:flowNodeRef>g_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_attend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_assessment_teacher" name="Преподаватель">
        <bpmn:flowNodeRef>g_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_grade</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_assessment_system" name="ИС">
        <bpmn:flowNodeRef>g_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="g_start" name="Время приёма">
      <bpmn:outgoing>gf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="g_attend" name="Прийти на приём">
      <bpmn:incoming>gf1</bpmn:incoming>
      <bpmn:outgoing>gf2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="g_receive" name="Провести приём">
      <bpmn:incoming>gf2</bpmn:incoming>
      <bpmn:outgoing>gf3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="g_grade" name="Отметить результат">
      <bpmn:incoming>gf3</bpmn:incoming>
      <bpmn:outgoing>gf4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="g_save" name="Сохранить результат">
      <bpmn:incoming>gf4</bpmn:incoming>
      <bpmn:outgoing>gf5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="g_end" name="Результат доступен">
      <bpmn:incoming>gf5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="gf1" sourceRef="g_start" targetRef="g_attend"/>
    <bpmn:sequenceFlow id="gf2" sourceRef="g_attend" targetRef="g_receive"/>
    <bpmn:sequenceFlow id="gf3" sourceRef="g_receive" targetRef="g_grade"/>
    <bpmn:sequenceFlow id="gf4" sourceRef="g_grade" targetRef="g_save"/>
    <bpmn:sequenceFlow id="gf5" sourceRef="g_save" targetRef="g_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_assessment">
    <bpmn:participant id="Pool_assessment" name="TO-BE: приём и ручная отметка результата" processRef="Process_assessment"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_assessment">
    <bpmndi:BPMNPlane id="Plane_assessment" bpmnElement="Collab_assessment">
      <bpmndi:BPMNShape id="Pool_assessment_di" bpmnElement="Pool_assessment" isHorizontal="true">
        <dc:Bounds x="30" y="80" width="1170" height="540"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_assessment_student_di" bpmnElement="Lane_assessment_student" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="1140" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_assessment_teacher_di" bpmnElement="Lane_assessment_teacher" isHorizontal="true">
        <dc:Bounds x="60" y="260" width="1140" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_assessment_system_di" bpmnElement="Lane_assessment_system" isHorizontal="true">
        <dc:Bounds x="60" y="440" width="1140" height="180"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_start_di" bpmnElement="g_start">
        <dc:Bounds x="110" y="140" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="184" width="100" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_attend_di" bpmnElement="g_attend">
        <dc:Bounds x="210" y="120" width="130" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_receive_di" bpmnElement="g_receive">
        <dc:Bounds x="410" y="310" width="130" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_grade_di" bpmnElement="g_grade">
        <dc:Bounds x="610" y="310" width="130" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_save_di" bpmnElement="g_save">
        <dc:Bounds x="810" y="490" width="130" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_end_di" bpmnElement="g_end">
        <dc:Bounds x="1030" y="508" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="988.0" y="552" width="120" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="gf1_di" bpmnElement="gf1">
        <di:waypoint x="146" y="158"/>
        <di:waypoint x="210" y="158"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf2_di" bpmnElement="gf2">
        <di:waypoint x="275" y="216"/>
        <di:waypoint x="275" y="346"/>
        <di:waypoint x="410" y="346"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf3_di" bpmnElement="gf3">
        <di:waypoint x="540" y="346"/>
        <di:waypoint x="610" y="346"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf4_di" bpmnElement="gf4">
        <di:waypoint x="740" y="346"/>
        <di:waypoint x="775" y="346"/>
        <di:waypoint x="775" y="526"/>
        <di:waypoint x="810" y="526"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf5_di" bpmnElement="gf5">
        <di:waypoint x="940" y="526"/>
        <di:waypoint x="1030" y="526"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
