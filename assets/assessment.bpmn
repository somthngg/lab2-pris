<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_assessment" targetNamespace="https://example.org/consultation-concept">
  <bpmn:process id="Process_assessment" name="TO-BE: защита и фиксация результата" isExecutable="false">
    <bpmn:laneSet id="LaneSet_assessment">
      <bpmn:lane id="Lane_assessment_teacher" name="Преподаватель">
        <bpmn:flowNodeRef>g_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_presence</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_defend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_grade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_absent</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_assessment_system" name="Сайт">
        <bpmn:flowNodeRef>g_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="g_start" name="Настало время слота">
      <bpmn:outgoing>gf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="g_check" name="Проверить явку">
      <bpmn:incoming>gf1</bpmn:incoming>
      <bpmn:outgoing>gf2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="g_presence" name="Студент пришёл?" default="gf5">
      <bpmn:incoming>gf2</bpmn:incoming>
      <bpmn:outgoing>gf3</bpmn:outgoing>
      <bpmn:outgoing>gf5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="g_defend" name="Принять защиту">
      <bpmn:incoming>gf3</bpmn:incoming>
      <bpmn:outgoing>gf4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="g_grade" name="Отметить Сдал или Не сдал">
      <bpmn:incoming>gf4</bpmn:incoming>
      <bpmn:outgoing>gf6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="g_absent" name="Отметить Не пришёл">
      <bpmn:incoming>gf5</bpmn:incoming>
      <bpmn:outgoing>gf7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="g_save" name="Сохранить результат и историю">
      <bpmn:incoming>gf6</bpmn:incoming>
      <bpmn:incoming>gf7</bpmn:incoming>
      <bpmn:outgoing>gf8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="g_end" name="Результат доступен">
      <bpmn:incoming>gf8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="gf1" sourceRef="g_start" targetRef="g_check"/>
    <bpmn:sequenceFlow id="gf2" sourceRef="g_check" targetRef="g_presence"/>
    <bpmn:sequenceFlow id="gf3" sourceRef="g_presence" targetRef="g_defend" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">studentPresent</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="gf4" sourceRef="g_defend" targetRef="g_grade"/>
    <bpmn:sequenceFlow id="gf5" sourceRef="g_presence" targetRef="g_absent" name="Нет"/>
    <bpmn:sequenceFlow id="gf6" sourceRef="g_grade" targetRef="g_save"/>
    <bpmn:sequenceFlow id="gf7" sourceRef="g_absent" targetRef="g_save"/>
    <bpmn:sequenceFlow id="gf8" sourceRef="g_save" targetRef="g_end"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_assessment">
    <bpmn:participant id="Pool_assessment" name="TO-BE: защита и фиксация результата" processRef="Process_assessment"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_assessment">
    <bpmndi:BPMNPlane id="Plane_assessment" bpmnElement="Collab_assessment">
      <bpmndi:BPMNShape id="Pool_assessment_di" bpmnElement="Pool_assessment" isHorizontal="true">
        <dc:Bounds x="30" y="80" width="1390" height="600"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_assessment_teacher_di" bpmnElement="Lane_assessment_teacher" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="1360" height="360"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_assessment_system_di" bpmnElement="Lane_assessment_system" isHorizontal="true">
        <dc:Bounds x="60" y="440" width="1360" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_start_di" bpmnElement="g_start">
        <dc:Bounds x="110" y="170" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="214" width="100" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_check_di" bpmnElement="g_check">
        <dc:Bounds x="220" y="145" width="150" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_presence_di" bpmnElement="g_presence" isMarkerVisible="true">
        <dc:Bounds x="440" y="168" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="405" y="102" width="120" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_defend_di" bpmnElement="g_defend">
        <dc:Bounds x="600" y="125" width="150" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_grade_di" bpmnElement="g_grade">
        <dc:Bounds x="810" y="125" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_absent_di" bpmnElement="g_absent">
        <dc:Bounds x="650" y="300" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_save_di" bpmnElement="g_save">
        <dc:Bounds x="1040" y="500" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="g_end_di" bpmnElement="g_end">
        <dc:Bounds x="1280" y="530" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1238.0" y="574" width="120" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="gf1_di" bpmnElement="gf1">
        <di:waypoint x="146" y="188"/>
        <di:waypoint x="220" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf2_di" bpmnElement="gf2">
        <di:waypoint x="370" y="193"/>
        <di:waypoint x="440" y="193"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf3_di" bpmnElement="gf3">
        <di:waypoint x="490" y="193"/>
        <di:waypoint x="545" y="193"/>
        <di:waypoint x="545" y="173"/>
        <di:waypoint x="600" y="173"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="482.5" y="171.0" width="70" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf4_di" bpmnElement="gf4">
        <di:waypoint x="750" y="173"/>
        <di:waypoint x="810" y="173"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf5_di" bpmnElement="gf5">
        <di:waypoint x="465" y="218"/>
        <di:waypoint x="465" y="348"/>
        <di:waypoint x="650" y="348"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="430.0" y="261.0" width="70" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf6_di" bpmnElement="gf6">
        <di:waypoint x="895" y="221"/>
        <di:waypoint x="895" y="260"/>
        <di:waypoint x="1125" y="260"/>
        <di:waypoint x="1125" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf7_di" bpmnElement="gf7">
        <di:waypoint x="820" y="348"/>
        <di:waypoint x="970" y="348"/>
        <di:waypoint x="970" y="548"/>
        <di:waypoint x="1040" y="548"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="gf8_di" bpmnElement="gf8">
        <di:waypoint x="1210" y="548"/>
        <di:waypoint x="1280" y="548"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
