<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_to-be" targetNamespace="https://example.org/consultation-concept">
  <bpmn:process id="Process_to-be" name="TO-BE: запись на защиту одной работы" isExecutable="false">
    <bpmn:laneSet id="LaneSet_to-be">
      <bpmn:lane id="Lane_to-be_student" name="Студент">
        <bpmn:flowNodeRef>q_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q_choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q_retry</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_to-be_system" name="Сайт">
        <bpmn:flowNodeRef>q_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q_free</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>q_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="q_start" name="Открыта очередь">
      <bpmn:outgoing>qf1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="q_choose" name="Выбрать слот и указать работу">
      <bpmn:incoming>qf1</bpmn:incoming>
      <bpmn:incoming>qf7</bpmn:incoming>
      <bpmn:outgoing>qf2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="q_check" name="Проверить и закрепить место">
      <bpmn:incoming>qf2</bpmn:incoming>
      <bpmn:outgoing>qf3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="q_free" name="Запись создана?" default="qf5">
      <bpmn:incoming>qf3</bpmn:incoming>
      <bpmn:outgoing>qf4</bpmn:outgoing>
      <bpmn:outgoing>qf5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="q_confirm" name="Показать подтверждение">
      <bpmn:incoming>qf4</bpmn:incoming>
      <bpmn:outgoing>qf6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="q_end" name="Студент записан">
      <bpmn:incoming>qf6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="q_retry" name="Выбрать другое свободное время">
      <bpmn:incoming>qf5</bpmn:incoming>
      <bpmn:outgoing>qf7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="qf1" sourceRef="q_start" targetRef="q_choose"/>
    <bpmn:sequenceFlow id="qf2" sourceRef="q_choose" targetRef="q_check"/>
    <bpmn:sequenceFlow id="qf3" sourceRef="q_check" targetRef="q_free"/>
    <bpmn:sequenceFlow id="qf4" sourceRef="q_free" targetRef="q_confirm" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">bookingCreated</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="qf5" sourceRef="q_free" targetRef="q_retry" name="Нет"/>
    <bpmn:sequenceFlow id="qf6" sourceRef="q_confirm" targetRef="q_end"/>
    <bpmn:sequenceFlow id="qf7" sourceRef="q_retry" targetRef="q_choose"/>
  </bpmn:process>
  <bpmn:collaboration id="Collab_to-be">
    <bpmn:participant id="Pool_to-be" name="TO-BE: запись на защиту одной работы" processRef="Process_to-be"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="Diagram_to-be">
    <bpmndi:BPMNPlane id="Plane_to-be" bpmnElement="Collab_to-be">
      <bpmndi:BPMNShape id="Pool_to-be_di" bpmnElement="Pool_to-be" isHorizontal="true">
        <dc:Bounds x="30" y="80" width="1310" height="500"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_to-be_student_di" bpmnElement="Lane_to-be_student" isHorizontal="true">
        <dc:Bounds x="60" y="80" width="1280" height="260"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_to-be_system_di" bpmnElement="Lane_to-be_system" isHorizontal="true">
        <dc:Bounds x="60" y="340" width="1280" height="240"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_start_di" bpmnElement="q_start">
        <dc:Bounds x="110" y="170" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="100" y="214" width="100" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_choose_di" bpmnElement="q_choose">
        <dc:Bounds x="240" y="145" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_check_di" bpmnElement="q_check">
        <dc:Bounds x="490" y="400" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_free_di" bpmnElement="q_free" isMarkerVisible="true">
        <dc:Bounds x="740" y="423" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="705.0" y="481" width="120" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_confirm_di" bpmnElement="q_confirm">
        <dc:Bounds x="930" y="400" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_end_di" bpmnElement="q_end">
        <dc:Bounds x="1190" y="430" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1148.0" y="474" width="120" height="55"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="q_retry_di" bpmnElement="q_retry">
        <dc:Bounds x="930" y="145" width="170" height="96"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="qf1_di" bpmnElement="qf1">
        <di:waypoint x="146" y="188"/>
        <di:waypoint x="240" y="188"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf2_di" bpmnElement="qf2">
        <di:waypoint x="325" y="241"/>
        <di:waypoint x="325" y="448"/>
        <di:waypoint x="490" y="448"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf3_di" bpmnElement="qf3">
        <di:waypoint x="660" y="448"/>
        <di:waypoint x="740" y="448"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf4_di" bpmnElement="qf4">
        <di:waypoint x="790" y="448"/>
        <di:waypoint x="930" y="448"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825.0" y="426.0" width="70" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf5_di" bpmnElement="qf5">
        <di:waypoint x="765" y="423"/>
        <di:waypoint x="765" y="193"/>
        <di:waypoint x="930" y="193"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="730.0" y="286.0" width="70" height="18"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf6_di" bpmnElement="qf6">
        <di:waypoint x="1100" y="448"/>
        <di:waypoint x="1190" y="448"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="qf7_di" bpmnElement="qf7">
        <di:waypoint x="1015" y="145"/>
        <di:waypoint x="1015" y="105"/>
        <di:waypoint x="325" y="105"/>
        <di:waypoint x="325" y="145"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
